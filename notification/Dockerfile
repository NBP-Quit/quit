FROM openjdk:17-jdk-slim

WORKDIR /app

ARG FILE_DIRECTORY
ARG SERVICE
RUN echo " 현재 작업 디렉토리 : ${FILE_DIRECTORY}"
RUN echo " 현재 작업 서비스 : ${SERVICE}"

ARG SLACK_TOKEN
ARG EUREKA_PROD_URL
ARG REDIS_HOST
ARG REDIS_PORT

RUN echo " SLACK_TOKEN : ${SLACK_TOKEN}"
RUN echo " EUREKA_PROD_URL : ${EUREKA_PROD_URL}"

ENV SLACK_TOKEN=$SLACK_TOKEN
ENV EUREKA_PROD_URL=$EUREKA_PROD_URL
ENV REDIS_HOST=$REDIS_HOST
ENV REDIS_PORT=$REDIS_PORT

COPY $FILE_DIRECTORY /app

COPY $FILE_DIRECTORY/build/libs/*.jar ./app.jar

ENTRYPOINT ["java","-jar","app.jar"]

