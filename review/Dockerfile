FROM openjdk:17-jdk-slim

WORKDIR /app

ARG FILE_DIRECTORY

ARG EUREKA_PROD_URL
ARG DATASOURCE_DRIVER_CLASS_NAME
ARG DATASOURCE_PROD_USERNAME
ARG DATASOURCE_PROD_PASSWORD
ARG REVIEW_DATASOURCE_PROD_URL
ARG REDIS_HOST
ARG REDIS_PORT
ARG S3_ACCESS_KEY
ARG S3_SECRET_KEY
ARG S3_BUCKET

ENV EUREKA_PROD_URL=$EUREKA_PROD_URL
ENV DATASOURCE_DRIVER_CLASS_NAME=$DATASOURCE_DRIVER_CLASS_NAME
ENV DATASOURCE_PROD_USERNAME=$DATASOURCE_PROD_USERNAME
ENV DATASOURCE_PROD_PASSWORD=$DATASOURCE_PROD_PASSWORD
ENV REVIEW_DATASOURCE_PROD_URL=$REVIEW_DATASOURCE_PROD_URL
ENV REDIS_HOST=$REDIS_HOST
ENV REDIS_PORT=$REDIS_PORT
ENV S3_ACCESS_KEY=$S3_ACCESS_KEY
ENV S3_SECRET_KEY=$S3_SECRET_KEY
ENV S3_BUCKET=$S3_BUCKET

COPY $FILE_DIRECTORY /app

COPY $FILE_DIRECTORY/build/libs/*.jar ./app.jar

ENTRYPOINT ["java","-jar","app.jar"]
