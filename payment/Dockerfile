FROM openjdk:17-jdk-slim

WORKDIR /app

ARG FILE_DIRECTORY

ARG EUREKA_PROD_URL
ARG DATASOURCE_DRIVER_CLASS_NAME
ARG DATASOURCE_PROD_USERNAME
ARG DATASOURCE_PROD_PASSWORD
ARG PAYMENT_DATASOURCE_PROD_URL
ARG PAYMENT_SECRET_KEY

ENV EUREKA_PROD_URL=$EUREKA_PROD_URL
ENV DATASOURCE_DRIVER_CLASS_NAME=$DATASOURCE_DRIVER_CLASS_NAME
ENV DATASOURCE_PROD_USERNAME=$DATASOURCE_PROD_USERNAME
ENV DATASOURCE_PROD_PASSWORD=$DATASOURCE_PROD_PASSWORD
ENV PAYMENT_DATASOURCE_PROD_URL=$PAYMENT_DATASOURCE_PROD_URL
ENV PAYMENT_SECRET_KEY=$PAYMENT_SECRET_KEY

COPY $FILE_DIRECTORY /app

COPY $FILE_DIRECTORY/build/libs/*.jar ./app.jar

ENTRYPOINT ["java","-jar","app.jar"]
